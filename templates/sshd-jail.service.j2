{{ ansible_managed | comment }}
[Unit]
Description=OpenSSH Jail/SFTP Server
Documentation=man:sshd(8) man:sshd_config(5)
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStartPre=/usr/sbin/sshd -t -f {{ sshd_jail_config_path }}
ExecStart=/usr/sbin/sshd -D -f {{ sshd_jail_config_path }}
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
